# Copy to `.env` and fill in — or set these as real environment variables.
# The proxy reads them with getenv(); never commit your real key.

# Required — your Claude API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=sk-ant-...

# Optional — which model answers. Defaults to claude-opus-5.
# For a high-volume support widget, claude-haiku-4-5 is cheaper and faster;
# claude-sonnet-5 is a middle ground.
ANTHROPIC_MODEL=claude-opus-5

# Optional — restrict which site may call the proxy (CORS). Defaults to "*".
# Set this to your domain in production, e.g. https://example.com
CHAT_ALLOWED_ORIGIN=*

# Optional — the assistant's persona / instructions.
# CHAT_SYSTEM_PROMPT="You are the assistant for Example Co. Answer questions about our pricing and services..."

# Optional — safety caps.
CHAT_MAX_TURNS=20
CHAT_MAX_CHARS=4000
